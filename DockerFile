FROM ubuntu:24.04

# Link to the GitHub repo
LABEL org.opencontainers.image.source="https://github.com/CodeMender-Demo/cm-github-actions"
LABEL org.opencontainers.image.description="Custom runner for CodeMender CLI"

# Prevent interactive prompts during package installs
ENV DEBIAN_FRONTEND=noninteractive

# Install core runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install the CodeMender CLI (example binary installation)
RUN curl -L -o cm-linux-amd64.zip "https://artifactregistry.googleapis.com/download/v1/projects/cmoc-prod/locations/us/repositories/codemender-cli-production/files/cm%3Astable%3Acm-linux-amd64.zip:download?alt=media" \
    && unzip cm-linux-amd64.zip \
    && chmod +x cm \
    && mv cm /usr/local/bin/cm

# Verify CLI installation
RUN cm --version
RUN cm init

ENTRYPOINT ["/bin/bash"]